#!/bin/sh
# deepai-up: DeepAI Code をバックグラウンド(非表示)で起動し、
# ローカルプロキシ(DeepAI モデル API)が応答するまで待機する。
#
# ローカルプロキシのポートと API キーは DeepAI Code の起動ごとに変わるため、
# 待機中は models.json を毎回読み直して現行のポートへ接続を試みる。
#
# 使い方:
#   deepai-up            起動済みなら即終了。未起動ならヘッドレス起動して準備を待つ
#   deepai-up --status   状態だけ確認して終了(ready なら 0 / 未起動なら 1)
#
# deepai-ready から呼ばれる(単独でも実行可)。
set -eu

APP_HOME="${T3CODE_HOME:-$HOME/.deepai-code}"
APP='/Applications/DeepAI Code.app'
PI_CONFIG="${PI_CODING_AGENT_DIR:-$APP_HOME/userdata/deepai/pi/deepai}"
MODELS_FILE="$PI_CONFIG/models.json"
WAIT_SECONDS="${DEEPAI_UP_WAIT:-60}"

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

proxy_url() {
  python3 -c 'import json, sys
try:
    print(json.load(open(sys.argv[1]))["providers"]["deepai"].get("baseUrl", ""))
except Exception:
    pass' "$MODELS_FILE" 2>/dev/null || true
}

# 何らかの HTTP 応答(404 でも)があればプロキシは生きている。
proxy_alive() {
  [ -n "${1:-}" ] && curl -s -o /dev/null --max-time 2 "$1/"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --status)
    URL="$(proxy_url)"
    if proxy_alive "$URL"; then
      echo "deepai-up: ready ($URL)"
      exit 0
    fi
    echo "deepai-up: not running (last known: ${URL:-none})" >&2
    exit 1
    ;;
  '')
    ;;
  *)
    echo "deepai-up: 不明なオプションです: $1" >&2
    exit 2
    ;;
esac

URL="$(proxy_url)"
if proxy_alive "$URL"; then
  echo "deepai-up: 起動済みです ($URL)"
  exit 0
fi

if [ ! -d "$APP" ]; then
  echo "deepai-up: DeepAI Code アプリが見つかりません: $APP" >&2
  exit 127
fi

echo "deepai-up: DeepAI Code をバックグラウンドで起動します…" >&2
open -g -j "$APP" >/dev/null 2>&1 || {
  echo "deepai-up: アプリの起動に失敗しました。" >&2
  exit 1
}

i=0
while [ "$i" -lt "$WAIT_SECONDS" ]; do
  URL="$(proxy_url)"
  if proxy_alive "$URL"; then
    echo "deepai-up: ready ($URL)"
    exit 0
  fi
  sleep 1
  i=$((i + 1))
done

echo "deepai-up: ${WAIT_SECONDS} 秒待ってもローカルプロキシが応答しません。" >&2
echo "deepai-up: DeepAI Code を手動で起動し、サインイン状態を確認してください。" >&2
exit 1
