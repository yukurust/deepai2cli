#!/bin/sh
# deepai-pi: `pi` のフレンドリーなラッパー。DeepAI Code 内蔵 Pi coding agent を
# 対話 / 非対話で実行します(実体と既定値は `pi` を参照)。
#
# 使い方:
#   deepai-pi                        対話セッションを開始
#   deepai-pi "調査して"              最初の指示を付けて開始
#   deepai-pi --print "調査して"      非対話で 1 回実行し、結果を標準出力へ
#
# オプション:
#   -p, --print           非対話モード。プロンプトを処理して終了する
#   -m, --model <id>      DeepAI のモデル ID (既定: mimo-2.6-pro)
#       --session-id <id> セッション ID を指定する (既定: 実行ごとに新規発行)
#   -h, --help            このヘルプを表示
set -eu

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

MODEL='mimo-2.6-pro'
MODEL_SET=0
SESSION_ID=''
PRINT_MODE=0
PROMPT=''

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -p|--print)
      PRINT_MODE=1
      shift
      ;;
    -m|--model)
      [ $# -ge 2 ] || { echo 'deepai-pi: --model にはモデル ID が必要です。' >&2; exit 2; }
      MODEL="$2"
      MODEL_SET=1
      shift 2
      ;;
    --session-id)
      [ $# -ge 2 ] || { echo 'deepai-pi: --session-id には ID が必要です。' >&2; exit 2; }
      SESSION_ID="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "deepai-pi: 不明なオプションです: $1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -gt 0 ]; then
  PROMPT="$*"
fi

case "$MODEL" in
  deepai/*) MODEL="${MODEL#deepai/}" ;;
esac

# 同じディレクトリの `pi`(実体)に渡す。
SELF=$0
while [ -L "$SELF" ]; do
  TARGET=$(readlink "$SELF")
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
PI="$SCRIPT_DIR/pi"
if [ ! -x "$PI" ]; then
  echo "deepai-pi: 実体の pi が見つかりません: $PI" >&2
  exit 1
fi

set --
if [ "$PRINT_MODE" -eq 1 ]; then
  set -- "$@" --print
fi
if [ "$MODEL_SET" -eq 1 ]; then
  set -- "$@" --model "deepai/$MODEL"
fi
if [ -n "$SESSION_ID" ]; then
  set -- "$@" --session-id "$SESSION_ID"
fi
if [ -n "$PROMPT" ]; then
  set -- "$@" -- "$PROMPT"
fi

exec "$PI" "$@"
